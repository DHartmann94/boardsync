{
    "tags": {
        "allowUnknownTags": true
    },
    "source": {
        "include": [
            "src/app"
        ],
        "includePattern": "\\.ts$",
        "excludePattern": "(node_modules/|docs|\\.spec\\.ts$)"
    },
    "plugins": [
        "plugins/markdown",
        "node_modules/better-docs/typescript"
    ],
    "opts": {
        "template": "node_modules/better-docs",
        "destination": "./docs-jsdoc",
        "recurse": true
    }
}